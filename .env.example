# Server-side Gemini API key (configured via Settings > Secrets)
GEMINI_API_KEY=

# Optional Gemini model override (defaults to gemini-4-hydrogen)
GEMINI_MODEL=

# Client-side Google Maps Platform API key (restrict by HTTP referrer and enabled APIs)
VITE_GOOGLE_MAPS_API_KEY=

# Comma-separated list of additional allowed browser origins for CORS (same-origin is always allowed)
ALLOWED_ORIGINS=

# Reverse-proxy hop count for verified client IP extraction (default: 1)
TRUST_PROXY=1

# Upstream Gemini request timeout in milliseconds (default: 15000)
GEMINI_TIMEOUT_MS=15000

# Set to "true" to return 503 maintenance responses on API endpoints while keeping /api/health active
MAINTENANCE_MODE=false
